<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:viewmodels="clr-namespace:HeartRateOverlay.ViewModels"
               x:Class="HeartRateOverlay.SettingsPopup"
               x:DataType="viewmodels:MainViewModel">

    <Border Stroke="{StaticResource NeonBlue}" 
            StrokeThickness="2" 
            BackgroundColor="{StaticResource FightSurface}" 
            Padding="25" 
            WidthRequest="300">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="15">
            <Label Text="⚙️ Overlay Settings" 
                   TextColor="{StaticResource PureWhite}" 
                   FontAttributes="Bold" 
                   FontSize="22"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <Label Text="Screen Position:" TextColor="{StaticResource PureWhite}" />
            <Picker ItemsSource="{Binding Positions}"
                    SelectedItem="{Binding SelectedPosition}"
                    TextColor="{StaticResource NeonGreen}"
                    BackgroundColor="{StaticResource FightBlack}"
                    Title="Choose Position" />

            <Label Text="Heart Rate Color:" TextColor="{StaticResource PureWhite}" />
            <Picker ItemsSource="{Binding Colors}"
                    SelectedItem="{Binding SelectedColor}"
                    TextColor="{StaticResource NeonGreen}"
                    BackgroundColor="{StaticResource FightBlack}"
                    Title="Choose Color" />

            <Label Text="Display Size:" TextColor="{StaticResource PureWhite}" />
            <Picker ItemsSource="{Binding Sizes}"
                    SelectedItem="{Binding SelectedSize}"
                    TextColor="{StaticResource NeonGreen}"
                    BackgroundColor="{StaticResource FightBlack}"
                    Title="Choose Size" />

            <Button Text="Close" 
                    BackgroundColor="{StaticResource FightBlack}" 
                    TextColor="{StaticResource NeonBlue}"
                    BorderColor="{StaticResource NeonBlue}"
                    BorderWidth="1"
                    CornerRadius="8"
                    Margin="0,15,0,0"
                    Clicked="OnCloseClicked"/>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>